{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sver0411/ContextGit/schemas/uacp-handoff-1.0.schema.json",
  "title": "UACP Context Handoff 1.0",
  "type": "object",
  "required": ["format", "version", "protocol", "handoff_id", "created_at", "expires_at", "from_agent", "to_agent", "context_id", "context_branch", "message", "capabilities_required", "compatibility"],
  "properties": {
    "format": {"const": "context-git-handoff"},
    "version": {"const": "1.0"},
    "protocol": {"const": "UACP/1.0"},
    "handoff_id": {"type": "string", "pattern": "^hnd_[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "from_agent": {"$ref": "#/$defs/agentId"},
    "to_agent": {"$ref": "#/$defs/agentId"},
    "context_id": {"type": "string", "pattern": "^ctx_(?:[0-9a-f]{16}|[0-9a-f]{8})$"},
    "context_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "message": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 2000}]},
    "capabilities_required": {"$ref": "#/$defs/capabilityList"},
    "compatibility": {
      "type": "object",
      "required": ["percent", "satisfied", "missing", "unknown"],
      "properties": {
        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "satisfied": {"$ref": "#/$defs/capabilityList"},
        "missing": {"$ref": "#/$defs/capabilityList"},
        "unknown": {"$ref": "#/$defs/capabilityList"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "agentId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
    "capabilityList": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"}
    }
  }
}
