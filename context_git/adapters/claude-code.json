{
  "name": "claude-code",
  "display_name": "Claude Code",
  "capabilities": ["filesystem", "shell", "git", "python", "node", "network", "subagents", "browser"],
  "detect_env": ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"],
  "session_globs": [".claude/projects/**/*.jsonl"],
  "session_env_roots": [{"env": "CLAUDE_CONFIG_DIR", "globs": ["projects/**/*.jsonl"]}],
  "session_formats": ["jsonl"],
  "notes": "Anthropic Claude Code. V2 can explicitly import visible user/assistant messages; tool and thinking blocks are discarded."
}
